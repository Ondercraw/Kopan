# Servidor
NODE_ENV=development
PORT=3000

# MongoDB Atlas
# Nunca colocar credenciales reales en este archivo de ejemplo.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/panaderia?retryWrites=true&w=majority

# JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_BYTES
JWT_EXPIRES_IN=8h

# CORS
FRONTEND_URL=http://localhost:4200

# Supabase (opcional; service role sólo puede existir en backend)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=REEMPLAZAR_POR_ANON_KEY_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_POR_SERVICE_ROLE_KEY_PRIVADA
